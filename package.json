{
  "name": "opencode-remote-issues-plugin",
  "version": "0.1.0",
  "description": "OpenCode Desktop plugin that adds an Issues button, a /issues command, and a palette action to open the project's GitHub or GitLab issue tracker in the browser.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teogai/opencode-remote-issues-plugin.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "gitlab",
    "bitbucket",
    "issues",
    "desktop"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node test/remote-url.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
